using System;
using System.Net;
using System.Net.Sockets;
using System.Text;
using System.Threading;
using MySql.Data.MySqlClient;
using System.IO;

namespace GateServerDirectDB
{
    class Program
    {
        static string connectionString = "";
        static int port = 6000;
        static NetworkStream activeStream = null;
        static readonly object streamLock = new object();
        static readonly string logFilePath = "connectivitylog.txt";

        static void Main(string[] args)
        {
            LoadConfig();

            while (true)
            {
                try
                {
                    TcpListener server = new TcpListener(IPAddress.Any, port);
                    server.Start();
                    Console.WriteLine($"TCP Server started on port {port}");
                    LogToFile($"TCP Server started on port {port}");

                    Thread boomCheckThread = new Thread(CheckBoomsigContinuously);
                    boomCheckThread.IsBackground = true;
                    boomCheckThread.Start();

                    while (true)
                    {
                        TcpClient client = server.AcceptTcpClient();
                        Console.WriteLine("Client connected: " + client.Client.RemoteEndPoint);
                        LogToFile("Client connected: " + client.Client.RemoteEndPoint);

                        lock (streamLock)
                        {
                            activeStream = client.GetStream();
                        }

                        Thread thread = new Thread(() => HandleClient(client));
                        thread.Start();
                    }
                }
                catch (Exception ex)
                {
                    string msg = "TCP server crashed: " + ex.Message;
                    Console.WriteLine(msg);
                    LogToFile(msg);
                    Console.WriteLine("Retrying to start server in 5 seconds...");
                    Thread.Sleep(5000);
                }
            }
        }

        static void LoadConfig()
        {
            try
            {
                string[] lines = File.ReadAllLines("config.txt");

                foreach (string line in lines)
                {
                    if (line.StartsWith("server_port="))
                        int.TryParse(line.Substring("server_port=".Length), out port);
                    else if (line.StartsWith("db_connection="))
                        connectionString = line.Substring("db_connection=".Length);
                }

                LogToFile($"Configuration loaded. Port={port}");
            }
            catch (Exception ex)
            {
                LogToFile("Error reading config.txt: " + ex.Message);
                Console.WriteLine("Fatal: Could not read config.txt");
                Environment.Exit(1);
            }
        }

        static void HandleClient(TcpClient client)
        {
            NetworkStream stream = client.GetStream();
            byte[] buffer = new byte[1024];
            StringBuilder sb = new StringBuilder();

            while (true)
            {
                int bytesRead;
                try
                {
                    bytesRead = stream.Read(buffer, 0, buffer.Length);
                }
                catch
                {
                    Console.WriteLine("Client disconnected.");
                    LogToFile("Client disconnected unexpectedly.");
                    break;
                }

                if (bytesRead == 0) break;

                string received = Encoding.ASCII.GetString(buffer, 0, bytesRead);
                sb.Append(received);

                if (received.Contains("|HLT%"))
                {
                    LogToFile("Heartbeat received from Arduino.");
                }

                while (sb.ToString().Contains("|FF|"))
                {
                    string message = ExtractFullMessage(ref sb);
                    Console.WriteLine("Received: " + message);

                    if (message.StartsWith("|AA|"))
                    {
                        string[] parts = message.Split('|');
                        if (parts.Length >= 5)
                        {
                            string gate = parts[2];
                            string action = parts[3].ToLower(); // "entry" or "exit"
                            InsertIntoDatabase(gate, action);
                        }
                    }
                }
            }
        }

        static string ExtractFullMessage(ref StringBuilder sb)
        {
            int endIndex = sb.ToString().IndexOf("|FF|") + 4;
            string message = sb.ToString().Substring(0, endIndex);
            sb.Remove(0, endIndex);
            return message;
        }

        static void InsertIntoDatabase(string gate, string action)
        {
            try
            {
                using (MySqlConnection conn = new MySqlConnection(connectionString))
                {
                    conn.Open();
                    string sql = "INSERT INTO your_appname_carlog (gate, action, created_at, updated_at) VALUES (@gate, @action, NOW(), NOW())";
                    using (MySqlCommand cmd = new MySqlCommand(sql, conn))
                    {
                        cmd.Parameters.AddWithValue("@gate", gate);
                        cmd.Parameters.AddWithValue("@action", action);
                        int result = cmd.ExecuteNonQuery();
                        Console.WriteLine($"Inserted into DB: Gate={gate}, Action={action}");
                        LogToFile($"Inserted into DB: Gate={gate}, Action={action}");
                    }
                }
            }
            catch (Exception ex)
            {
                string errMsg = "DB Insert Error: " + ex.Message;
                Console.WriteLine(errMsg);
                LogToFile(errMsg);
            }
        }

        static void CheckBoomsigContinuously()
        {
            while (true)
            {
                try
                {
                    using (MySqlConnection conn = new MySqlConnection(connectionString))
                    {
                        conn.Open();
                        string query = "SELECT id, entryboom FROM boomsig WHERE entryboom = 'Y' LIMIT 1";
                        using (MySqlCommand cmd = new MySqlCommand(query, conn))
                        using (var reader = cmd.ExecuteReader())
                        {
                            if (reader.Read())
                            {
                                int boomId = reader.GetInt32("id");

                                Console.WriteLine("Boomsig entryboom = Y detected. Sending |OPENEN% to Arduino...");
                                LogToFile("Boomsig trigger detected. Sending |OPENEN% to Arduino.");

                                lock (streamLock)
                                {
                                    if (activeStream != null && activeStream.CanWrite)
                                    {
                                        byte[] data = Encoding.ASCII.GetBytes("|OPENEN%");
                                        activeStream.Write(data, 0, data.Length);
                                        Console.WriteLine("Sent: |OPENEN%");
                                        LogToFile("Sent command |OPENEN% to Arduino.");
                                    }
                                }

                                reader.Close();

                                string updateSql = "UPDATE boomsig SET entryboom = 'N', entrysynctime = NOW(), barrier_open_count = barrier_open_count + 1 WHERE id = @id";
                                using (MySqlCommand updateCmd = new MySqlCommand(updateSql, conn))
                                {
                                    updateCmd.Parameters.AddWithValue("@id", boomId);
                                    updateCmd.ExecuteNonQuery();
                                    LogToFile("Updated boomsig entryboom to 'N'.");
                                }
                            }
                        }
                    }
                }
                catch (Exception ex)
                {
                    string err = "Error checking boomsig: " + ex.Message;
                    Console.WriteLine(err);
                    LogToFile(err);
                }

                Thread.Sleep(2000);
            }
        }

        static void LogToFile(string message)
        {
            string logEntry = $"[{DateTime.Now:yyyy-MM-dd HH:mm:ss}] {message}";
            try
            {
                File.AppendAllText(logFilePath, logEntry + Environment.NewLine);
            }
            catch (Exception ex)
            {
                Console.WriteLine("Logging Error: " + ex.Message);
            }
        }
    }
}
