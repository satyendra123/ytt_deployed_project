#define relayPin 9
String receivedString = "";
unsigned long lastSendTime = 0;
const unsigned long sendInterval = 3000; // 3 seconds

void setup() {
  Serial.begin(115200);
  pinMode(relayPin, OUTPUT);
  digitalWrite(relayPin, HIGH);
}

void openGate() {
  digitalWrite(relayPin, LOW);
  delay(1000);
  digitalWrite(relayPin, HIGH);
}

void checkIncomingCommand() {
  if (Serial.available()) {
    char c = Serial.read();
    receivedString += c;

    if (c == '%') {
      receivedString.trim();
      Serial.println(receivedString); // echo received command
      if (receivedString == "|OPENEN%") {
        openGate();
      }
      receivedString = "";
    }
  }
}

void sendHeartbeat() {
  unsigned long currentMillis = millis();
  if (currentMillis - lastSendTime >= sendInterval) {
    Serial.println("|HLT%");
    lastSendTime = currentMillis;
  }
}

void loop() {
  checkIncomingCommand();
  sendHeartbeat();
}


